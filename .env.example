# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_URL"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# ── Supabase Service Role Key (server-side only) ──
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# ── n8n Webhook Integration ──
# URL base del webhook de n8n (debe terminar en /webhook/ o /webhook-test/)
# Opciones comunes:
#   - Local Docker: http://localhost:5678/webhook/
#   - Mismo VPS (Docker network): http://n8n:5678/webhook/
#   - Dominio propio: https://n8n.sistemaindumentaria.com/webhook/
N8N_WEBHOOK_URL="https://n8n.sistemaindumentaria.com/webhook/"

# Secret compartido para autenticar requests entre tu app Next.js y n8n
# Generá uno seguro con: openssl rand -base64 32
N8N_WEBHOOK_SECRET=""

# ── OpenAI (usado por n8n para procesamiento con LLM) ──
# Configurá este valor en n8n como "Credential" (Settings > Credentials > New)
OPENAI_API_KEY=""



# Playwright testing
PLAYWRIGHT_BASE_URL="http://127.0.0.1:3000"

# Test credentials for E2E tests
TEST_ADMIN_EMAIL="admin@test.com"
TEST_ADMIN_PASSWORD="testpassword"